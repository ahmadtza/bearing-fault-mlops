# Default text-file handling
* text=auto

# Source code and configuration
*.py      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.sh      text eol=lf
*.toml    text eol=lf
*.txt     text eol=lf
*.cnf     text eol=lf
*.m       text eol=lf

# Docker files
Dockerfile text eol=lf
Dockerfile.* text eol=lf

# Web/config formats
*.json    text eol=lf
*.conf    text eol=lf

# Binary files
*.mat     binary
*.joblib  binary
*.db      binary
*.dump    binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.pdf     binary
*.zip     binary
